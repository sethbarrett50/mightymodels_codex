#!/bin/sh
# Resolve the MightyModels workspace, with a persistent directory for MCP state.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(CDPATH= cd -- "$here/.." && pwd -P)
command -v uv >/dev/null 2>&1 || { echo "MightyModels Codex requires uv" >&2; exit 127; }
export UV_PROJECT="$root"
export UV_PROJECT_ENVIRONMENT="$root/.venv"
# Original server requires CLAUDE_PLUGIN_DATA (not merely PLUGIN_DATA).
export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-${PLUGIN_DATA:-${MIGHTYMODELS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mightymodels}}}"
mkdir -p "$CLAUDE_PLUGIN_DATA"
chmod 700 "$CLAUDE_PLUGIN_DATA"
cd "$root"
exec uv run --locked --no-dev --package mightymodels-mcp mightymodels-mcp
