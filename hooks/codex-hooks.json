{
  "description": "Codex-specific MightyModels dispatch admission; does not replace host sandbox permissions",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 12,
            "statusMessage": "Validating MightyModels agent dispatch"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 18,
            "statusMessage": "Saving MightyModels ticket state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^mm-triage-(code-scout|web-scout)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 18,
            "statusMessage": "Recording MightyModels scout evidence"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 18,
            "statusMessage": "Pruning stale MightyModels Codex session pointers"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__mighty_mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 18,
            "statusMessage": "Recording MightyModels active session pointer"
          }
        ]
      },
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_bridge.py\"",
            "timeout": 18,
            "statusMessage": "Recording explicit Codex Plan-mode user decisions"
          }
        ]
      }
    ]
  }
}
